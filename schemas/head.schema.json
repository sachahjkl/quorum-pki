{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quorum-pki.invalid/schemas/head.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "configHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "logId": {
      "type": "string",
      "minLength": 1
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stateRoot": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "previous": {
      "type": "string",
      "pattern": "^([0-9a-f]{64})?$"
    }
  },
  "required": [
    "version",
    "epoch",
    "configHash",
    "logId",
    "size",
    "root",
    "stateRoot",
    "timestamp",
    "previous"
  ],
  "additionalProperties": false
}
