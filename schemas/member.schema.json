{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quorum-pki.invalid/schemas/member.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "root": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "url": {
      "type": "string",
      "pattern": "^[\\x20-\\x7e]*$"
    }
  },
  "required": [
    "id",
    "key",
    "root",
    "url"
  ],
  "additionalProperties": false
}
