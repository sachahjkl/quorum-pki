{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quorum-pki.invalid/schemas/entry.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "previous": {
      "type": "string",
      "pattern": "^([0-9a-f]{64})?$"
    },
    "proposal": {
      "$ref": "proposal.schema.json"
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "approval.schema.json"
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "version",
    "sequence",
    "timestamp",
    "previous",
    "proposal",
    "approvals"
  ],
  "additionalProperties": false
}
