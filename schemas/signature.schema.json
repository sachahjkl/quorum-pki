{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quorum-pki.invalid/schemas/signature.schema.json",
  "type": "object",
  "properties": {
    "protected": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "required": [
    "protected",
    "signature"
  ],
  "additionalProperties": false
}
